{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/init-hooks.cjs\" session-start",
            "timeout": 5,
            "statusMessage": "Checking golang-project-init contract"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/init-hooks.cjs\" prompt-submit",
            "timeout": 5,
            "statusMessage": "Checking golang-project-init contract"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/init-hooks.cjs\" pretool-use",
            "timeout": 5,
            "statusMessage": "golang-project-init ship-gate"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/init-hooks.cjs\" stop",
            "timeout": 10,
            "statusMessage": "golang-project-init scaffold gate"
          }
        ]
      }
    ]
  }
}
