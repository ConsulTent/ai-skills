{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/mobile-hooks.cjs\" session-start",
            "timeout": 5,
            "statusMessage": "Checking mobile-convergence contract"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/mobile-hooks.cjs\" prompt-submit",
            "timeout": 5,
            "statusMessage": "Checking mobile-convergence contract"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/mobile-hooks.cjs\" pretool-use",
            "timeout": 5,
            "statusMessage": "mobile-convergence convergence gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/mobile-hooks.cjs\" tool-use",
            "timeout": 5,
            "statusMessage": "mobile-convergence plan approval"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/mobile-hooks.cjs\" stop",
            "timeout": 10,
            "statusMessage": "mobile-convergence convergence gate"
          }
        ]
      }
    ]
  }
}
